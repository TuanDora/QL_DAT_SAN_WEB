@model  MyCourtBooking.Models.ViewModels.ChangePasswordViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Đổi Mật Khẩu";
}

<div class="container my-4">
    <div class="row g-4">
        <!-- SIDEBAR -->
        <div class="col-md-3">
            <div class="card border-0 shadow-sm p-3 text-center" style="border-radius: 12px;">
                <h6 class="fw-bold mb-0 text-primary">TÀI KHOẢN CỦA TÔI</h6>
                <div class="list-group list-group-flush text-start small mt-3">
                    <a href="/Account/Profile" class="list-group-item list-group-item-action fw-semibold border-0 rounded-2 mb-1">
                        <i class="bi bi-person me-2"></i> Hồ sơ cá nhân
                    </a>
                    <a href="/Account/BookingHistory" class="list-group-item list-group-item-action fw-semibold border-0 rounded-2 mb-1">
                        <i class="bi bi-clock-history me-2"></i> Lịch sử đặt sân
                    </a>
                    <a href="/Account/ChangePassword" class="list-group-item list-group-item-action active fw-semibold border-0 rounded-2">
                        <i class="bi bi-shield-lock me-2"></i> Đổi mật khẩu
                    </a>
                </div>
            </div>
        </div>

        <!-- FORM ĐỔI MẬT KHẨU -->
        <div class="col-md-9">
            <div class="card border-0 shadow-sm p-4" style="border-radius: 12px; max-width: 600px;">
                <h5 class="fw-bold text-dark mb-3"><i class="bi bi-key-fill text-primary me-2"></i>Đổi mật khẩu tài khoản</h5>

                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show mb-3" role="alert">
                        <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }

                <form asp-action="ChangePassword" asp-controller="Account" method="post">
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label asp-for="CurrentPassword" class="form-label fw-semibold small">Mật khẩu hiện tại</label>
                        <input asp-for="CurrentPassword" class="form-control" placeholder="Nhập mật khẩu cũ">
                        <span asp-validation-for="CurrentPassword" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="NewPassword" class="form-label fw-semibold small">Mật khẩu mới</label>
                        <input asp-for="NewPassword" class="form-control" placeholder="Tối thiểu 6 ký tự">
                        <span asp-validation-for="NewPassword" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="ConfirmNewPassword" class="form-label fw-semibold small">Xác nhận mật khẩu mới</label>
                        <input asp-for="ConfirmNewPassword" class="form-control" placeholder="Nhập lại mật khẩu mới">
                        <span asp-validation-for="ConfirmNewPassword" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 py-2 fw-bold rounded-pill" style="background-color: var(--blue-accent);">
                        Cập nhật mật khẩu
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>