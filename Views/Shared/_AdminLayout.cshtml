<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Admin Portal</title>
    <!-- Bootstrap 5 & Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <style>
        body {
            background-color: #f4f6f9;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }
        /* Thiết kế Menu Sidebar */
        /* Thiết kế Menu Sidebar */
        .sidebar {
            background-color: #0b1320;
            height: 100vh; /* Cố định chiều cao đúng bằng màn hình */
            color: #fff;
            width: 260px;
            flex-shrink: 0;
            display: flex;
            flex-direction: column;
            overflow-y: auto; /* Bật thanh cuộn dọc cho sidebar */
        }

            .sidebar a {
                color: #a2adb9;
                text-decoration: none;
                padding: 12px 20px;
                display: block;
                border-radius: 6px;
                margin: 4px 15px;
                font-weight: 500;
                font-size: 0.95rem;
                transition: 0.2s;
            }

                .sidebar a:hover, .sidebar a.active {
                    background-color: #007bff;
                    color: #fff;
                }

            .sidebar .menu-title {
                font-size: 0.75rem;
                color: #5c6a7a;
                font-weight: 700;
                text-transform: uppercase;
                padding: 10px 25px 0;
                margin-top: 15px;
                letter-spacing: 0.5px;
            }
        
        .content-wrapper {
            width: 100%;
            padding: 25px;
            height: 100vh;
            overflow-y: auto;
            background-color: #f4f6f9;
        }

        .admin-avatar {
            width: 38px;
            height: 38px;
            background-color: #007bff;
            color: #fff;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: bold;
            font-size: 18px;
        }
    </style>
</head>
<body class="d-flex overflow-hidden">

    <!-- THANH MENU BÊN TRÁI (SIDEBAR) -->
    <div class="sidebar py-3 shadow-lg">
        <h5 class="text-white fw-bold px-4 mb-4 d-flex align-items-center">
            <i class="bi bi-shield-lock-fill text-primary fs-4 me-2"></i> ADMIN PORTAL
        </h5>
        
        <div class="px-3 mb-3 position-relative">
            <div class="dropdown">
                <!-- Nút bấm hiển thị thông tin admin và có mũi tên dropdown -->
                <a href="#" class="p-2 rounded-3 d-flex align-items-center text-decoration-none dropdown-toggle text-white"
                   data-bs-toggle="dropdown" aria-expanded="false"
                   style="background-color: rgba(255,255,255,0.08); border: 1px solid rgba(255,255,255,0.15);">
                    <div class="admin-avatar me-2 flex-shrink-0">@((User.Identity?.Name ?? "A").Substring(0, 1).ToUpper())</div>
                    <div class="overflow-hidden flex-grow-1">
                        <div class="fw-bold text-white text-truncate" style="font-size: 0.9rem;">@(User.Identity?.Name ?? "Quản trị viên")</div>
                        <div class="text-white-50 small text-truncate" style="font-size: 0.75rem;">Admin System</div>
                    </div>
                </a>

                <!-- Danh sách menu thả xuống (Dropdown Menu) -->
                <ul class="dropdown-menu dropdown-menu-dark shadow border-0 rounded-3 mt-1 w-100">
                    <li>
                        <a class="dropdown-item py-2" href="/Account/Profile">
                            <i class="bi bi-person me-2 text-primary"></i>Thông tin cá nhân
                        </a>
                    </li>
                    <li>
                        <a class="dropdown-item py-2" href="/">
                            <i class="bi bi-house-door me-2 text-info"></i>Về trang khách hàng
                        </a>
                    </li>
                    <li><hr class="dropdown-divider border-secondary"></li>
                    <li>
                        <a class="dropdown-item py-2 text-danger" href="/Auth/Logout">
                            <i class="bi bi-box-arrow-right me-2"></i>Đăng xuất
                        </a>
                    </li>
                </ul>
            </div>
        </div>

        <div class="menu-title">QUẢN LÝ CHÍNH</div>
        <a href="/Admin" class="@(ViewContext.RouteData.Values["Action"]?.ToString() == "Index" ? "active" : "")">
            <i class="bi bi-speedometer2 me-2"></i>Tổng quan
        </a>
        <a href="/Admin/ManageCourts" class="@(ViewContext.RouteData.Values["Action"]?.ToString() == "ManageCourts" ? "active" : "")">
            <i class="bi bi-dribbble me-2"></i>Quản lý Sân
        </a>
        <!-- Đã sửa href thành đường dẫn đúng đến trang Dịch vụ -->
        <a href="/Admin/ManageServices" class="@(ViewContext.RouteData.Values["Action"]?.ToString() == "ManageServices" ? "active" : "")">
            <i class="bi bi-box-seam me-2"></i>Dịch vụ & Kho hàng
        </a>
        <a href="/Admin/ManageBookings" class="@(ViewContext.RouteData.Values["Action"]?.ToString() == "ManageBookings" ? "active" : "")">
            <i class="bi bi-calendar-check me-2"></i>Duyệt Đặt Sân
        </a>
        <a href="/Admin/Reports" class="@(ViewContext.RouteData.Values["Action"]?.ToString() == "Reports" ? "active" : "")">
            <i class="bi bi-bar-chart-line me-2"></i>Báo cáo & Thống kê
        </a>

        <div class="menu-title mt-4">HỆ THỐNG & PHÂN QUYỀN</div>
        <a href="/Admin/ManageUsers" class="@(ViewContext.RouteData.Values["Action"]?.ToString() == "ManageUsers" ? "active" : "")">
            <i class="bi bi-people me-2"></i>Tài khoản & Quyền
        </a>
        <a href="/Admin/Pricing" class="@(ViewContext.RouteData.Values["Action"]?.ToString() == "Pricing" ? "active" : "")">
            <i class="bi bi-tags me-2"></i>Bảng giá & Giờ vàng
        </a>
        <a href="/Admin/Settings" class="@(ViewContext.RouteData.Values["Action"]?.ToString() == "Settings" ? "active" : "")">
            <i class="bi bi-gear me-2"></i>Cấu hình Hệ thống
        </a>
        <!-- Đã thay thế mục thừa bằng Nhật ký hoạt động hoạt động chuẩn xác -->
        <a href="/Admin/AuditLogs" class="@(ViewContext.RouteData.Values["Action"]?.ToString() == "AuditLogs" ? "active" : "")">
            <i class="bi bi-clock-history me-2"></i>Nhật ký Hoạt động
        </a>
        <div class="mt-auto px-3 pb-3">
            <a href="/" class="btn btn-outline-secondary w-100 text-start text-white border-secondary">
                <i class="bi bi-box-arrow-left me-2"></i>Về Trang Khách
            </a>
        </div>
    </div>

    <!-- KHU VỰC NỘI DUNG CHÍNH CHỨA CÁC TRANG CỦA BẠN -->
    <div class="content-wrapper">
        @RenderBody()
    </div>

    <!-- JavaScript Base -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery@3.6.4/dist/jquery.min.js"></script>
    
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>