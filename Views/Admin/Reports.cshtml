@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@model IEnumerable<MyCourtBooking.Modules.Admin.CourtReportViewModel>
@{
    Layout = "/Modules/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Báo Báo & Thống Kê Sân Cầu Lông";

    decimal totalRevenue = ViewBag.TotalRevenue != null ? Convert.ToDecimal(ViewBag.TotalRevenue) : 0m;
    int totalBookings = ViewBag.TotalBookings ?? 0;
    int totalCourts = ViewBag.TotalCourts ?? 0;
    int totalUsers = ViewBag.TotalUsers ?? 0;
}

<div class="container-fluid px-0 py-2">
    <!-- TIÊU ĐỀ & NÚT IN BÁO CÁO -->
    <div class="d-flex justify-content-between align-items-center mb-4 no-print">
        <div>
            <h3 class="fw-bold mb-1"><i class="bi bi-graph-up-arrow text-primary me-2"></i>Báo Cáo & Thống Kê Sân Cầu Lông</h3>
            <p class="text-muted mb-0">Số liệu thực tế cập nhật theo thời gian thực từ cơ sở dữ liệu hệ thống</p>
        </div>
        <div>
            <button type="button" class="btn btn-outline-primary rounded-pill px-4 shadow-sm fw-bold" onclick="window.print()">
                <i class="bi bi-printer me-2"></i>In Báo Cáo
            </button>
        </div>
    </div>

    <!-- HÀNG THẺ CHỈ SỐ TỔNG QUAN (REALTIME) -->
    <div class="row g-4 mb-4">
        <!-- 1. Doanh Thu -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm p-3 rounded-4 bg-primary text-white h-100">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <p class="mb-1 text-white-50 small text-uppercase fw-semibold">Tổng doanh thu thực tế</p>
                        <h4 class="fw-bold mb-0">@totalRevenue.ToString("#,##0") đ</h4>
                    </div>
                    <div class="bg-white bg-opacity-20 p-3 rounded-circle d-flex align-items-center justify-content-center" style="width: 55px; height: 55px;">
                        <i class="bi bi-cash-stack fs-2 text-white"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- 2. Lượt Đặt Sân -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm p-3 rounded-4 bg-white h-100">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <p class="mb-1 text-muted small text-uppercase fw-semibold">Lượt đặt sân</p>
                        <h4 class="fw-bold mb-0 text-dark">@totalBookings đơn</h4>
                    </div>
                    <div class="bg-primary bg-opacity-10 p-3 rounded-circle d-flex align-items-center justify-content-center" style="width: 55px; height: 55px;">
                        <i class="bi bi-calendar2-check fs-2 text-primary"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- 3. Số Lượng Sân -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm p-3 rounded-4 bg-white h-100">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <p class="mb-1 text-muted small text-uppercase fw-semibold">Số lượng sân cầu</p>
                        <h4 class="fw-bold mb-0 text-success">@totalCourts sân</h4>
                    </div>
                    <div class="bg-success bg-opacity-10 p-3 rounded-circle d-flex align-items-center justify-content-center" style="width: 55px; height: 55px;">
                        <i class="bi bi-dribbble fs-2 text-success"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- 4. Khách Hàng -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm p-3 rounded-4 bg-white h-100">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <p class="mb-1 text-muted small text-uppercase fw-semibold">Khách hàng đăng ký</p>
                        <h4 class="fw-bold mb-0 text-warning">@totalUsers người</h4>
                    </div>
                    <div class="bg-warning bg-opacity-10 p-3 rounded-circle d-flex align-items-center justify-content-center" style="width: 55px; height: 55px;">
                        <i class="bi bi-person-badge fs-2 text-warning"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- BẢNG HIỆU SUẤT TỪNG SÂN CẦU LÔNG -->
    <div class="card border-0 shadow-sm p-4 rounded-4 bg-white">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="fw-bold mb-0 text-primary">
                <i class="bi bi-bar-chart-fill me-2"></i>Hiệu suất khai thác từng sân Cầu Lông
            </h5>
            <span class="badge bg-success bg-opacity-10 text-success px-3 py-2 rounded-pill fw-semibold">
                <i class="bi bi-arrow-repeat me-1"></i>Dữ liệu Realtime
            </span>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="py-3">Tên sân cầu</th>
                        <th class="py-3">Loại Sân</th>
                        <th class="py-3">Giá / Giờ</th>
                        <th class="py-3 text-center">Lượt đặt thành công</th>
                        <th class="py-3">Tỷ lệ lấp đầy</th>
                        <th class="py-3 text-end">Doanh thu tạo ra</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="fw-bold text-dark">
                                    <i class="bi bi-geo-alt-fill text-danger me-1"></i>@item.CourtName
                                </td>
                                <td>
                                    <span class="badge bg-secondary bg-opacity-10 text-dark border px-3 py-1 rounded-pill">
                                        @item.Type
                                    </span>
                                </td>
                                <td class="fw-bold text-secondary">@item.PricePerHour.ToString("#,##0") đ</td>
                                <td class="text-center fw-bold text-primary">@item.TotalBookings</td>
                                <td style="min-width: 180px;">
                                    <div class="d-flex align-items-center">
                                        <div class="progress flex-grow-1 me-2" style="height: 8px;">
                                            <div class="progress-bar @(item.OccupancyRate >= 70 ? "bg-success" : item.OccupancyRate >= 40 ? "bg-info" : "bg-warning")"
                                                 role="progressbar"
                                                 style="width: @item.OccupancyRate%">
                                            </div>
                                        </div>
                                        <small class="fw-bold text-muted">@item.OccupancyRate%</small>
                                    </div>
                                </td>
                                <td class="text-end fw-bold text-success">@item.Revenue.ToString("#,##0") đ</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center py-4 text-muted">Chưa có dữ liệu thống kê sân cầu lông trong hệ thống.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- STYLES HỖ TRỢ IN BÁO CÁO DỄ DÀNG -->
<style type="text/css" media="print">
    @@page {
        size: auto;
        margin: 15mm;
    }

    body {
        background-color: #fff !important;
    }

    .no-print, nav, header, sidebar, .btn {
        display: none !important;
    }

    .card {
        border: 1px solid #ddd !important;
        box-shadow: none !important;
    }
</style>