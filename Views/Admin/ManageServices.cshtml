@model List<MyCourtBooking.Core.Entities.Service>
@{
    ViewData["Title"] = "Quản lý Dịch vụ & Kho hàng";
    Layout = "_AdminLayout";
}

<div class="container-fluid px-0">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark mb-1">Quản lý Dịch vụ & Tồn kho</h2>
            <p class="text-muted small mb-0">Theo dõi danh sách nước uống, đồ ăn, dịch vụ cho thuê và số lượng tồn kho thực tế.</p>
        </div>
        <button type="button" class="btn btn-primary fw-semibold px-3 py-2 rounded-3 shadow-sm" data-bs-toggle="modal" data-bs-target="#addServiceModal">
            <i class="bi bi-plus-lg me-1"></i> Thêm dịch vụ mới
        </button>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- BẢNG DANH SÁCH DỊCH VỤ -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light text-uppercase fs-7 text-muted">
                        <tr>
                            <th class="py-3 ps-4">#ID</th>
                            <th class="py-3">Tên dịch vụ / Sản phẩm</th>
                            <th class="py-3">Phân loại</th>
                            <th class="py-3">Đơn giá</th>
                            <th class="py-3">Tồn kho</th>
                            <th class="py-3">Đơn vị tính</th>
                            <th class="py-3 text-end pe-4">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="ps-4 fw-bold text-muted">#@item.Id</td>
                                    <td class="fw-semibold text-dark">@item.Name</td>
                                    <td>
                                        @if (item.Category == "Nước uống")
                                        {
                                            <span class="badge bg-primary bg-opacity-10 text-primary px-2 py-1">@item.Category</span>
                                        }
                                        else if (item.Category == "Đồ ăn")
                                        {
                                            <span class="badge bg-warning bg-opacity-10 text-warning px-2 py-1">@item.Category</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-info bg-opacity-10 text-info px-2 py-1">@item.Category</span>
                                        }
                                    </td>
                                    <td class="fw-bold text-success">@item.Price.ToString("N0") đ</td>
                                    <td>
                                        @if (item.Stock <= 5)
                                        {
                                            <span class="badge bg-danger px-2 py-1">Sắp hết (@item.Stock)</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success px-2 py-1">@item.Stock</span>
                                        }
                                    </td>
                                    <td>@item.Unit</td>
                                    <td class="text-end pe-4">
                                        <!-- NÚT SỬA BẬT MODAL -->
                                        <button class="btn btn-sm btn-outline-primary px-2 py-1 me-1" data-bs-toggle="modal" data-bs-target="#editServiceModal-@item.Id">
                                            <i class="bi bi-pencil"></i> Sửa
                                        </button>

                                        <!-- NÚT XÓA VỚI FORM POST -->
                                        <form method="post" action="/Admin/DeleteService" style="display:inline;" onsubmit="return confirm('Bạn có chắc chắn muốn xóa dịch vụ \'@item.Name\'?');">
                                            <input type="hidden" name="id" value="@item.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger px-2 py-1">
                                                <i class="bi bi-trash"></i> Xóa
                                            </button>
                                        </form>
                                    </td>
                                </tr>

                                <!-- MODAL SỬA DỊCH VỤ -->
                                <div class="modal fade" id="editServiceModal-@item.Id" tabindex="-1" aria-hidden="true">
                                    <div class="modal-dialog modal-dialog-centered">
                                        <div class="modal-content border-0 shadow-lg rounded-4">
                                            <div class="modal-header border-0 pb-0">
                                                <h5 class="modal-title fw-bold">Cập nhật dịch vụ / sản phẩm</h5>
                                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                            </div>
                                            <form method="post" action="/Admin/EditService">
                                                <input type="hidden" name="Id" value="@item.Id" />
                                                <div class="modal-body py-3 text-start">
                                                    <div class="mb-3">
                                                        <label class="form-label small fw-semibold">Tên sản phẩm / Dịch vụ</label>
                                                        <input type="text" class="form-control rounded-3" name="Name" value="@item.Name" required />
                                                    </div>
                                                    <div class="row">
                                                        <div class="col-md-6 mb-3">
                                                            <label class="form-label small fw-semibold">Phân loại</label>
                                                            <select class="form-select rounded-3" name="Category">
                                                                <option value="Nước uống" selected="@(item.Category == "Nước uống")">Nước uống</option>
                                                                <option value="Đồ ăn" selected="@(item.Category == "Đồ ăn")">Đồ ăn</option>
                                                                <option value="Dịch vụ" selected="@(item.Category == "Dịch vụ")">Dịch vụ</option>
                                                            </select>
                                                        </div>
                                                        <div class="col-md-6 mb-3">
                                                            <label class="form-label small fw-semibold">Đơn vị tính</label>
                                                            <input type="text" class="form-control rounded-3" name="Unit" value="@item.Unit" required />
                                                        </div>
                                                    </div>
                                                    <div class="row">
                                                        <div class="col-md-6 mb-3">
                                                            <label class="form-label small fw-semibold">Đơn giá (VNĐ)</label>
                                                            <input type="number" class="form-control rounded-3" name="Price" value="@Convert.ToInt64(item.Price)" required />
                                                        </div>
                                                        <div class="col-md-6 mb-3">
                                                            <label class="form-label small fw-semibold">Số lượng tồn kho</label>
                                                            <input type="number" class="form-control rounded-3" name="Stock" value="@item.Stock" required />
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="modal-footer border-0 pt-0">
                                                    <button type="button" class="btn btn-light rounded-3" data-bs-dismiss="modal">Hủy</button>
                                                    <button type="submit" class="btn btn-primary rounded-3 px-4">Cập nhật</button>
                                                </div>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center py-4 text-muted">Chưa có dịch vụ nào trong cơ sở dữ liệu.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- MODAL THÊM DỊCH VỤ MỚI -->
<div class="modal fade" id="addServiceModal" tabindex="-1" aria-labelledby="addServiceModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold" id="addServiceModalLabel">Thêm dịch vụ / Sản phẩm mới</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form method="post" action="/Admin/CreateService">
                <div class="modal-body py-3">
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Tên sản phẩm / Dịch vụ</label>
                        <input type="text" class="form-control rounded-3" name="Name" placeholder="Ví dụ: Nước Bò húc..." required />
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label small fw-semibold">Phân loại</label>
                            <select class="form-select rounded-3" name="Category">
                                <option value="Nước uống">Nước uống</option>
                                <option value="Đồ ăn">Đồ ăn</option>
                                <option value="Dịch vụ">Dịch vụ</option>
                            </select>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label small fw-semibold">Đơn vị tính</label>
                            <input type="text" class="form-control rounded-3" name="Unit" placeholder="Chai, Lon, Hộp, Lần..." required />
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label small fw-semibold">Đơn giá (VNĐ)</label>
                            <input type="number" class="form-control rounded-3" name="Price" placeholder="10000" required />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label small fw-semibold">Số lượng nhập kho</label>
                            <input type="number" class="form-control rounded-3" name="Stock" placeholder="100" required />
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-light rounded-3" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-primary rounded-3 px-4">Lưu sản phẩm</button>
                </div>
            </form>
        </div>
    </div>
</div>