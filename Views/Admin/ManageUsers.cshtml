@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@model IEnumerable<MyCourtBooking.Models.Entities.User>
@{
    Layout = "/Modules/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Quản lý Tài khoản & Phân quyền";

    var staffList = Model?.Where(u => u.Role == "Admin" || u.Role == "Staff").ToList() ?? new List<MyCourtBooking.Models.Entities.User>();
    var customerList = Model?.Where(u => u.Role != "Admin" && u.Role != "Staff").ToList() ?? new List<MyCourtBooking.Models.Entities.User>();
}

<div class="container-fluid px-0 py-2">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold mb-1"><i class="bi bi-people-fill text-primary me-2"></i>Quản Lý Tài Khoản & Phân Quyền</h3>
            <p class="text-muted mb-0">Quản lý danh sách thành viên và phân quyền nhân sự hệ thống sân cầu lông</p>
        </div>
        <div>
            <button class="btn btn-primary rounded-pill px-4 shadow-sm fw-semibold" data-bs-toggle="modal" data-bs-target="#addStaffModal">
                <i class="bi bi-person-plus-fill me-2"></i>Thêm nhân sự mới
            </button>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 mb-4 shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-3 mb-4 shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- THANH ĐIỀU HƯỚNG TAB -->
    <ul class="nav nav-tabs nav-fill mb-4 border-0 gap-2" id="userTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active fw-semibold py-3 rounded-4 shadow-sm bg-white text-dark border-0" id="staff-tab" data-bs-toggle="tab" data-bs-target="#staff-pane" type="button" role="tab">
                <i class="bi bi-shield-lock-fill text-primary me-2 fs-5"></i>Nhân sự & Quản trị viên (@staffList.Count)
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link fw-semibold py-3 rounded-4 shadow-sm bg-white text-dark border-0" id="customer-tab" data-bs-toggle="tab" data-bs-target="#customer-pane" type="button" role="tab">
                <i class="bi bi-people-fill text-success me-2 fs-5"></i>Khách hàng đặt sân (@customerList.Count)
            </button>
        </li>
    </ul>

    <!-- NỘI DUNG CÁC TAB -->
    <div class="tab-content" id="userTabsContent">
        <!-- TAB 1: NHÂN SỰ NỘI BỘ -->
        <div class="tab-pane fade show active" id="staff-pane" role="tabpanel">
            <div class="card border-0 shadow-sm p-4 rounded-4 bg-white">
                <h5 class="fw-bold mb-3 text-secondary">Danh sách Quản trị và Lễ tân trực sân</h5>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="py-3">Họ và tên</th>
                                <th class="py-3">Email đăng nhập</th>
                                <th class="py-3">Số điện thoại</th>
                                <th class="py-3">Chức vụ / Vai trò</th>
                                <th class="py-3">Trạng thái</th>
                                <th class="py-3 text-end">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (staffList.Any())
                            {
                                foreach (var user in staffList)
                                {
                                    var initial = !string.IsNullOrWhiteSpace(user.FullName) ? user.FullName.Trim()[0].ToString().ToUpper() : "U";
                                    <tr>
                                        <td class="fw-bold">
                                            <div class="d-flex align-items-center">
                                                <div class="avatar bg-primary text-white rounded-circle d-flex align-items-center justify-content-center fw-bold me-2" style="width: 35px; height: 35px;">@initial</div>
                                                @user.FullName
                                            </div>
                                        </td>
                                        <td>@user.Email</td>
                                        <td>@(string.IsNullOrWhiteSpace(user.PhoneNumber) ? "---" : user.PhoneNumber)</td>
                                        <td>
                                            @if (user.Role == "Admin")
                                            {
                                                <span class="badge bg-danger bg-opacity-10 text-danger px-3 py-2 rounded-pill">Administrator</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-warning bg-opacity-10 text-dark px-3 py-2 rounded-pill">Nhân viên Lễ tân</span>
                                            }
                                        </td>
                                        <td>
                                            @if (user.IsActive == true)
                                            {
                                                <span class="badge bg-success bg-opacity-10 text-success px-3 py-2 rounded-pill">Đang hoạt động</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary bg-opacity-10 text-secondary px-3 py-2 rounded-pill">Đã khóa</span>
                                            }
                                        </td>
                                        <td class="text-end">
                                            <button class="btn btn-sm btn-outline-primary rounded-circle me-1" data-bs-toggle="modal" data-bs-target="#editUserModal@(user.Id)" title="Chỉnh sửa">
                                                <i class="bi bi-pencil-square"></i>
                                            </button>
                                            <form asp-controller="Admin" asp-action="ToggleUserStatus" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="userId" value="@user.Id" />
                                                <button type="submit" class="btn btn-sm btn-outline-danger rounded-circle" onclick="return confirm('Bạn có chắc muốn thay đổi trạng thái tài khoản này?');" title="Đổi trạng thái">
                                                    <i class="bi bi-power"></i>
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="6" class="text-center py-4 text-muted">Chưa có tài khoản nhân sự nội bộ.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- TAB 2: KHÁCH HÀNG ĐẶT SÂN -->
        <div class="tab-pane fade" id="customer-pane" role="tabpanel">
            <div class="card border-0 shadow-sm p-4 rounded-4 bg-white">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="fw-bold mb-0 text-secondary">Danh sách Khách hàng thân thiết</h5>
                    <form asp-controller="Admin" asp-action="ManageUsers" method="get" class="input-group w-25">
                        <input type="text" name="searchString" value="@Context.Request.Query["searchString"]" class="form-control form-control-sm rounded-start-3" placeholder="Tìm kiếm khách hàng...">
                        <button class="btn btn-outline-primary btn-sm rounded-end-3" type="submit"><i class="bi bi-search"></i></button>
                    </form>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="py-3">ID</th>
                                <th class="py-3">Họ tên khách hàng</th>
                                <th class="py-3">Email</th>
                                <th class="py-3">Số điện thoại</th>
                                <th class="py-3">Trạng thái tài khoản</th>
                                <th class="py-3 text-end">Hành động</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (customerList.Any())
                            {
                                foreach (var user in customerList)
                                {
                                    <tr>
                                        <td>#@user.Id</td>
                                        <td class="fw-semibold text-dark">@user.FullName</td>
                                        <td>@user.Email</td>
                                        <td>@(string.IsNullOrWhiteSpace(user.PhoneNumber) ? "---" : user.PhoneNumber)</td>
                                        <td>
                                            @if (user.IsActive == true)
                                            {
                                                <span class="badge bg-success bg-opacity-10 text-success px-3 py-2 rounded-pill">Hoạt động</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-danger bg-opacity-10 text-danger px-3 py-2 rounded-pill">Đã khóa</span>
                                            }
                                        </td>
                                        <td class="text-end">
                                            <button class="btn btn-sm btn-outline-primary rounded-circle me-1" data-bs-toggle="modal" data-bs-target="#editUserModal@(user.Id)" title="Chỉnh sửa">
                                                <i class="bi bi-pencil-square"></i>
                                            </button>
                                            <form asp-controller="Admin" asp-action="ToggleUserStatus" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="userId" value="@user.Id" />
                                                <button type="submit" class="btn btn-sm btn-outline-danger rounded-circle" onclick="return confirm('Bạn có chắc muốn thay đổi trạng thái khóa/mở tài khoản này?');" title="Khóa / Mở tài khoản">
                                                    <i class="bi bi-lock"></i>
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="6" class="text-center py-4 text-muted">Chưa có dữ liệu khách hàng trong hệ thống.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal Thêm Nhân Sự Mới -->
<div class="modal fade" id="addStaffModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 rounded-4 shadow">
            <div class="modal-header border-0 pb-0">
                <h5 class="fw-bold text-primary"><i class="bi bi-person-plus me-2"></i>Thêm Nhân sự Nội bộ Mới</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body pt-3">
                <form asp-controller="Admin" asp-action="CreateStaff" method="post">
                    @Html.AntiForgeryToken()
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Họ và tên nhân viên <span class="text-danger">*</span></label>
                        <input type="text" name="fullName" class="form-control rounded-3" placeholder="Ví dụ: Nguyễn Văn A" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Email nội bộ <span class="text-danger">*</span></label>
                        <input type="email" name="email" class="form-control rounded-3" placeholder="staff@sanbadminton.vn" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Số điện thoại <span class="text-danger">*</span></label>
                        <input type="text" name="phoneNumber" class="form-control rounded-3" placeholder="090..." required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Phân quyền vai trò</label>
                        <select name="role" class="form-select rounded-3">
                            <option value="Staff">Nhân viên Lễ tân (Duyệt đơn, Quản lý sân)</option>
                            <option value="Admin">Quản trị viên tối cao (Admin)</option>
                        </select>
                    </div>
                    <div class="text-end mt-4">
                        <button type="button" class="btn btn-light rounded-pill px-4 me-2" data-bs-dismiss="modal">Hủy</button>
                        <button type="submit" class="btn btn-primary rounded-pill px-4 shadow-sm fw-bold">Tạo tài khoản</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Modal Chỉnh sửa cho từng User -->
@if (Model != null && Model.Any())
{
    foreach (var user in Model)
    {
        <div class="modal fade" id="editUserModal@(user.Id)" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content border-0 rounded-4 shadow">
                    <div class="modal-header border-0 pb-0">
                        <h5 class="fw-bold text-primary"><i class="bi bi-pencil-square me-2"></i>Chỉnh sửa tài khoản #@user.Id</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body pt-3">
                        <form asp-controller="Admin" asp-action="EditUser" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@user.Id" />
                            <div class="mb-3">
                                <label class="form-label fw-semibold">Họ và tên <span class="text-danger">*</span></label>
                                <input type="text" name="fullName" value="@user.FullName" class="form-control rounded-3" required />
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-semibold">Email <span class="text-danger">*</span></label>
                                <input type="email" name="email" value="@user.Email" class="form-control rounded-3" required />
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-semibold">Số điện thoại <span class="text-danger">*</span></label>
                                <input type="text" name="phoneNumber" value="@user.PhoneNumber" class="form-control rounded-3" required />
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-semibold">Chức vụ / Vai trò</label>
                                <select name="role" class="form-select rounded-3">
                                    <option value="Customer" selected="@(user.Role == "Customer")">Khách hàng</option>
                                    <option value="Staff" selected="@(user.Role == "Staff")">Nhân viên Lễ tân</option>
                                    <option value="Admin" selected="@(user.Role == "Admin")">Quản trị viên (Admin)</option>
                                </select>
                            </div>
                            <div class="text-end mt-4">
                                <button type="button" class="btn btn-light rounded-pill px-4 me-2" data-bs-dismiss="modal">Hủy</button>
                                <button type="submit" class="btn btn-primary rounded-pill px-4 shadow-sm fw-bold">Lưu thay đổi</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    }
}