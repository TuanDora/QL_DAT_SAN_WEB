@{
    Layout = "_Layout";
    ViewData["Title"] = "Quên mật khẩu";
}

<div class="row justify-content-center py-5">
    <div class="col-md-5">
        <div class="card border-0 shadow-lg" style="border-radius: 20px;">
            <div class="card-body p-4">
                <h3 class="fw-bold text-center mb-2" style="color: #0f1f3d;">Khôi phục mật khẩu</h3>
                <p class="text-muted text-center small mb-4">Nhập email tài khoản của bạn để nhận hướng dẫn đặt lại mật khẩu.</p>

                @if (ViewBag.Error != null)
                {
                    <div class="alert alert-danger py-2 small mb-3">
                        <i class="bi bi-exclamation-triangle-fill me-1"></i> @ViewBag.Error
                    </div>
                }

                @if (ViewBag.Success != null)
                {
                    <div class="alert alert-success py-2 small mb-3">
                        <i class="bi bi-check-circle-fill me-1"></i> @ViewBag.Success
                    </div>
                }

                <form action="/Auth/ForgotPassword" method="post">
                    @Html.AntiForgeryToken()
                    
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Email đăng ký</label>
                        <input type="email" name="email" class="form-control py-2" placeholder="name@example.com" required />
                    </div>

                    <button type="submit" class="btn btn-primary w-100 fw-bold py-2 mt-2 rounded-pill" style="background-color: var(--blue-accent);">
                        Gửi yêu cầu
                    </button>

                    <div class="text-center mt-3 small">
                        <a href="/?openAuth=true" class="text-muted text-decoration-none">
                            <i class="bi bi-arrow-left me-1"></i>Quay lại Đăng nhập
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>