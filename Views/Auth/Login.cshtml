@model  MyCourtBooking.Models.ViewModels.LoginViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Đăng nhập hệ thống";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card border-0 shadow-sm p-4" style="border-radius: 16px; background: white;">
                <h3 class="fw-bold text-center mb-1 text-primary" style="color: #0f1f3d !important;">MYCOURT BOOKING</h3>
                <p class="text-center text-muted mb-4 small">Đăng nhập tài khoản để đặt sân cầu lông online</p>

                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger">
                        @Html.ValidationSummary(false, "", new { @class = "mb-0" })
                    </div>
                }

                <form asp-action="Login" asp-controller="Auth" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="ReturnUrl" />

                    <div class="mb-3">
                        <label asp-for="EmailOrPhone" class="form-label fw-semibold"></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light"><i class="bi bi-person"></i></span>
                            <input asp-for="EmailOrPhone" class="form-control" placeholder="Nhập Email hoặc SĐT" />
                        </div>
                        <span asp-validation-for="EmailOrPhone" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label fw-semibold"></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light"><i class="bi bi-lock"></i></span>
                            <input asp-for="Password" class="form-control" placeholder="Nhập mật khẩu" id="pagePassword" />
                            <button class="btn btn-outline-secondary" type="button" onclick="togglePasswordVisibility('pagePassword', this)">
                                <i class="bi bi-eye-slash"></i>
                            </button>
                        </div>
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="form-check mb-3">
                        <input asp-for="RememberMe" class="form-check-input" />
                        <label asp-for="RememberMe" class="form-check-label text-muted small"></label>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 py-2 fw-bold text-uppercase" style="background-color: #1f5fe0; border: none; border-radius: 8px;">
                        Đăng nhập
                    </button>
                </form>

                <div class="text-center mt-3">
                    <span class="text-muted small">Chưa có tài khoản? </span>
                    <a href="javascript:void(0)" onclick="openAuthModal('register')" class="fw-bold text-primary text-decoration-none">Đăng ký ngay</a>
                </div>
            </div>
        </div>
    </div>
</div>