@model List< MyCourtBooking.Models.ViewModels.MyBookingItemViewModel>

@{
    ViewData["Title"] = "Đơn đặt của tôi";
}

<div class="container py-4">
    <div class="d-flex align-items-center justify-content-between mb-4">
        <h3 class="fw-bold text-dark mb-0"><i class="bi bi-journal-check text-success me-2"></i>Đơn Đặt Sân Của Tôi</h3>
        <a href="/Courts" class="btn btn-outline-success btn-sm fw-semibold rounded-pill">+ Đặt thêm sân mới</a>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="card border-0 shadow-sm rounded-4 p-5 text-center bg-white">
            <div class="mb-3">
                <i class="bi bi-calendar-x text-muted display-4"></i>
            </div>
            <h5 class="fw-bold text-secondary">Bạn chưa có đơn đặt sân nào!</h5>
            <p class="text-muted small">Hãy chọn sân và đặt khung giờ trải nghiệm ngay hôm nay.</p>
            <div class="mt-2">
                <a href="/Courts" class="btn btn-success px-4 py-2 rounded-pill fw-bold">Xem Danh Sách Sân</a>
            </div>
        </div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var item in Model)
            {
                <div class="col-12">
                    <div class="card border-0 shadow-sm rounded-4 bg-white overflow-hidden">
                        <div class="card-body p-4">
                            <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 pb-3 border-bottom">
                                <div>
                                    <span class="fw-bold text-dark fs-5">Mã đơn: #@item.BookingCode</span>
                                    <span class="text-muted small ms-2">· Ngày tạo: @item.CreatedAt.ToString("dd/MM/yyyy HH:mm")</span>
                                </div>
                                <div>
                                    <span class="badge @item.StatusClass px-3 py-2 rounded-pill fw-semibold">@item.StatusText</span>
                                </div>
                            </div>

                            <div class="row g-3">
                                <div class="col-md-8">
                                    <h6 class="fw-bold text-secondary small mb-2">CHI TIẾT KHUNG GIỜ ĐẶT:</h6>
                                    @if (item.Details != null && item.Details.Any())
                                    {
                                        <ul class="list-unstyled mb-0 small">
                                            @foreach (var detail in item.Details)
                                            {
                                                <li class="mb-1 text-dark">
                                                    <i class="bi bi-geo-alt-fill text-danger me-1"></i>
                                                    <strong>@detail.CourtName</strong>
                                                    · Ngày chơi: <span class="fw-semibold">@detail.PlayDate.ToString("dd/MM/yyyy")</span>
                                                    · Giờ: <span class="badge bg-light text-dark border">@detail.StartTime - @detail.EndTime</span>
                                                </li>
                                            }
                                        </ul>
                                    }
                                </div>

                                <div class="col-md-4 text-md-end d-flex flex-column justify-content-between">
                                    <div>
                                        <span class="text-muted small d-block">Tổng tiền thanh toán:</span>
                                        <span class="fs-4 fw-bold text-danger">@item.TotalAmount.ToString("#,##0") VNĐ</span>
                                    </div>
                                    <div class="mt-2">
                                        <span class="text-muted small">SĐT nhận tin: <strong>@item.CustomerPhone</strong></span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>