<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MyCourtBooking</title>

    <!-- Font & Icon -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

    <!-- Custom CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/courts.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/booking.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-success shadow-sm sticky-top">
            <div class="container">
                <!-- Logo -->
                <a class="navbar-brand fw-bold fs-4 d-flex align-items-center" href="/">
                    <i class="fa-solid fa-feather-pointed me-2"></i>MyCourtBooking
                </a>

                <!-- Nút thu nhỏ menu trên mobile -->
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarContent">
                    <!-- 1. MENU BÊN TRÁI -->
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link fw-semibold" href="/"><i class="bi bi-house-door me-1"></i>Trang chủ</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link fw-semibold" href="/Courts"><i class="bi bi-dribbble me-1"></i>Danh sách sân</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link fw-semibold" href="/Bookings/MyBookings"><i class="bi bi-journal-check me-1"></i>Đơn đặt của tôi</a>
                        </li>
                        <!-- Nút vào Admin chỉ hiện khi user có Role Admin -->
                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link fw-bold text-warning" href="/Admin">
                                    <i class="bi bi-speedometer2 me-1"></i>Quản trị (Admin)
                                </a>
                            </li>
                        }
                    </ul>

                    <!-- 2. MENU BÊN PHẢI (TÀI KHOẢN) -->
                    <ul class="navbar-nav ms-auto align-items-center">
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item dropdown">
                                <a class="btn btn-light text-success fw-bold rounded-pill px-3 dropdown-toggle d-flex align-items-center gap-2 shadow-sm" href="#" id="userDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-person-circle fs-5"></i>
                                    <span>@(User.Identity?.Name ?? "Tài khoản")</span>
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end shadow border-0 rounded-3 mt-2">
                                    <li>
                                        <a class="dropdown-item py-2" href="/Account/Profile">
                                            <i class="bi bi-person me-2 text-success"></i>Thông tin tài khoản
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider"></li>

                                    <!-- NÚT VÀO TRANG QUẢN TRỊ (HIỆN CHO ADMIN) -->
                                    @if (User.IsInRole("Admin")
                                        || User.Claims.Any(c => c.Value.ToLower().Contains("admin"))
                                        || User.Identity?.Name == "Quản trị viên")
                                    {
                                        <li>
                                            <a class="dropdown-item py-2 text-primary fw-bold bg-light" href="/Admin">
                                                <i class="bi bi-shield-lock-fill me-2"></i>Trang Quản Trị (Admin)
                                            </a>
                                        </li>
                                        <li><hr class="dropdown-divider"></li>
                                    }

                                    <li>
                                        <a class="dropdown-item py-2 text-danger" href="/Auth/Logout">
                                            <i class="bi bi-box-arrow-right me-2"></i>Đăng xuất
                                        </a>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <button type="button" class="btn text-white fw-semibold d-flex align-items-center gap-2 px-2 py-1 bg-transparent border-0" data-bs-toggle="modal" data-bs-target="#loginModal">
                                    <i class="bi bi-person fs-4"></i>
                                    <span class="fs-6">Đăng nhập</span>
                                </button>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main role="main" class="container py-4">
        @RenderBody()
    </main>

    <footer class="footer bg-dark text-white-50 py-4 mt-auto">
        <div class="container text-center">
            <p class="mb-1 fw-bold text-white">MyCourtBooking - Hệ Thống Đặt Sân Cầu Lông Trực Tuyến</p>
            <p class="small mb-0">&copy; 2026 - Đồ án Lập trình Web ASP.NET Core MVC.</p>
        </div>
    </footer>

    <!-- JS Libraries -->
    <script src="https://cdn.jsdelivr.net/npm/jquery@3.6.4/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Custom JS -->
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/booking.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

    <!-- ================= AUTH MODAL (ĐĂNG NHẬP) ================= -->
    <div class="modal fade" id="loginModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" style="max-width: 420px;">
            <div class="modal-content border-0 shadow-lg" style="border-radius: 24px;">
                <div class="modal-header border-0 pb-0 pe-4 pt-4">
                    <button type="button" class="btn-close ms-auto" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4 pt-1">
                    <div class="mb-3 text-start">
                        <span class="text-muted small">Xin chào bạn</span>
                        <h3 class="fw-bold mt-1" style="color: #0f1f3d;">Đăng nhập để tiếp tục</h3>
                    </div>

                    <div id="loginErrorAlert" class="alert alert-danger py-2 small mb-3 @(TempData["AuthError"] != null ? "" : "d-none")" role="alert">
                        <i class="bi bi-exclamation-triangle-fill me-1"></i>
                        <span id="loginErrorMessage">@(TempData["AuthError"] ?? "")</span>
                    </div>

                    <form id="modalLoginForm" action="/Auth/Login" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="ReturnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
    
                        <div class="input-group mb-3">
                            <span class="input-group-text bg-white border-end-0 rounded-start-3 text-muted ps-3"><i class="bi bi-person"></i></span>
                            <!-- Chú ý: thuộc tính name phải là 'Email' viết hoa chữ E cho khớp với LoginViewModel -->
                            <input type="text" id="modalEmail" name="Email" class="form-control border-start-0 rounded-end-3 py-2" placeholder="Email hoặc số điện thoại" required />
                        </div>

                        <div class="input-group mb-3">
                            <span class="input-group-text bg-white border-end-0 rounded-start-3 text-muted ps-3"><i class="bi bi-lock"></i></span>
                            <!-- Chú ý: thuộc tính name phải là 'Password' viết hoa chữ P -->
                            <input type="password" id="modalPassword" name="Password" class="form-control border-start-0 border-end-0 py-2" placeholder="Mật khẩu" required />
                            <span class="input-group-text bg-white border-start-0 rounded-end-3 text-muted pe-3" style="cursor: pointer;" onclick="togglePasswordVisibility()">
                                <i class="bi bi-eye-slash" id="togglePasswordIcon"></i>
                            </span>
                        </div>

                        <button type="submit" id="btnModalLogin" class="btn btn-outline-dark w-100 fw-bold py-2 mb-3 rounded-pill" style="border-color: #333;">Đăng nhập</button>

                        <div class="text-start mb-4">
                            <a href="/Auth/ForgotPassword" class="text-dark fw-bold text-decoration-none small">Quên mật khẩu ?</a>
                        </div>

                        <div class="d-flex align-items-center mb-4">
                            <hr class="flex-grow-1 m-0 text-muted opacity-25">
                            <span class="px-3 text-muted small">Hoặc tài khoản</span>
                            <hr class="flex-grow-1 m-0 text-muted opacity-25">
                        </div>

                        <div class="row g-2 mb-4">
                            <div class="col-6">
                                <a href="/Auth/GoogleLogin" class="btn btn-light w-100 border text-dark fw-semibold small py-2 d-flex align-items-center justify-content-center gap-2 rounded-3">
                                    <svg width="18" height="18" viewBox="0 0 24 24"><path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" /><path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" /><path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z" /><path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z" /></svg>
                                    Google
                                </a>
                            </div>
                            <div class="col-6">
                                <a href="/Auth/ZaloLogin" class="btn btn-light w-100 border text-dark fw-semibold small py-2 d-flex align-items-center justify-content-center gap-2 rounded-3">
                                    <i class="bi bi-chat-fill text-primary"></i> Zalo
                                </a>
                            </div>
                        </div>

                        <div class="text-center small">
                            Chưa là thành viên? <a href="/Auth/Register" class="text-danger fw-bold text-decoration-none">Đăng ký</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- SCRIPT XỬ LÝ ĐĂNG NHẬP TRUYỀN THỐNG -->
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // 1. Tự động bật Modal nếu có lỗi đăng nhập từ trước
            var urlParams = new URLSearchParams(window.location.search);
            var hasError = "@(TempData["AuthError"] != null ? "true" : "false")";
            var modalElem = document.getElementById('loginModal');

            if ((urlParams.get('openAuth') === 'true' || hasError === "true") && modalElem) {
                var bs = window['bootstrap'];
                if (bs && bs.Modal) {
                    var loginModal = new bs.Modal(modalElem);
                    loginModal.show();
                }
            }
        });

        // Hàm ẩn/hiện mật khẩu
        function togglePasswordVisibility() {
            var passwordInput = document.getElementById('modalPassword');
            var icon = document.getElementById('togglePasswordIcon');
            if (passwordInput && icon) {
                if (passwordInput.getAttribute('type') === 'password') {
                    passwordInput.setAttribute('type', 'text');
                    icon.classList.replace('bi-eye-slash', 'bi-eye');
                } else {
                    passwordInput.setAttribute('type', 'password');
                    icon.classList.replace('bi-eye', 'bi-eye-slash');
                }
            }
        }
    </script>
</body>
</html>