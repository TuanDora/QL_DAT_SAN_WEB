@model MyCourtBooking.Modules.Auth.ResetPasswordViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Đặt Lại Mật Khẩu";
}

<div class="d-flex justify-content-center align-items-center vh-100 bg-light">
    <div class="card border-0 shadow-sm p-4" style="max-width: 450px; width: 100%; border-radius: 16px;">
        <h3 class="fw-bold text-center text-dark mb-2">Đặt lại mật khẩu</h3>
        <p class="text-muted text-center small mb-4">Nhập mật khẩu mới cho tài khoản <b>@Model.Email</b></p>

        <!-- HIỂN THỊ LỖI NẾU CÓ -->
        @if (ViewBag.ErrorMessage != null || TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show small mb-3" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>@(ViewBag.ErrorMessage ?? TempData["ErrorMessage"])
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        @if (!ViewData.ModelState.IsValid && ViewData.ModelState.Values.Any(v => v.Errors.Count > 0))
        {
            <div class="alert alert-danger small mb-3" role="alert">
                <ul class="mb-0 ps-3">
                    @foreach (var modelState in ViewData.ModelState.Values)
                    {
                        foreach (var error in modelState.Errors)
                        {
                            if (!string.IsNullOrEmpty(error.ErrorMessage))
                            {
                                <li>@error.ErrorMessage</li>
                            }
                        }
                    }
                </ul>
            </div>
        }

        <form asp-action="ResetPassword" asp-controller="Auth" method="post">
            @Html.AntiForgeryToken()

            <input type="hidden" name="Token" value="@Model.Token" />
            <input type="hidden" name="Email" value="@Model.Email" />

            <div class="mb-3">
                <label class="form-label fw-semibold small">Mật khẩu mới</label>
                <input type="password" id="NewPassword" name="NewPassword" class="form-control" placeholder="Tối thiểu 6 ký tự" required />
            </div>

            <div class="mb-4">
                <label class="form-label fw-semibold small">Xác nhận mật khẩu mới</label>
                <input type="password" id="ConfirmPassword" name="ConfirmPassword" class="form-control" placeholder="Nhập lại mật khẩu mới" required />
            </div>

            <button type="submit" class="btn btn-primary w-100 py-2 fw-bold text-white rounded-pill">
                Xác nhận đặt lại mật khẩu
            </button>
        </form>
    </div>
</div>