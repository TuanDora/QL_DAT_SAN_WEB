@{
    Layout = "_Layout";
    ViewData["Title"] = "Khôi Phục Mật Khẩu";
}

<div class="d-flex justify-content-center align-items-center vh-100 bg-light">
    <div class="card border-0 shadow-sm p-4 text-center" style="max-width: 450px; width: 100%; border-radius: 16px;">
        <h3 class="fw-bold text-dark mb-2">Khôi phục mật khẩu</h3>
        <p class="text-muted small mb-4">Nhập email tài khoản của bạn để nhận hướng dẫn đặt lại mật khẩu.</p>

        <!-- 1. THÔNG BÁO THÀNH CÔNG (BẮT CẢ VIEWBAG VÀ TEMPDATA) -->
        @if (ViewBag.SuccessMessage != null || TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show text-start small mb-3" role="alert">
                <i class="bi bi-check-circle-fill me-2"></i>@(ViewBag.SuccessMessage ?? TempData["SuccessMessage"])
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <!-- 2. THÔNG BÁO LỖI SERVER / SMTP (BẮT CẢ VIEWBAG VÀ TEMPDATA) -->
        @if (ViewBag.ErrorMessage != null || TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show text-start small mb-3" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>@(ViewBag.ErrorMessage ?? TempData["ErrorMessage"])
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <!-- 3. THÔNG BÁO LỖI VALIDATION MODEL -->
        @if (!ViewData.ModelState.IsValid && ViewData.ModelState.Values.Any(v => v.Errors.Count > 0))
        {
            <div class="alert alert-danger text-start small mb-3" role="alert">
                <ul class="mb-0 ps-3">
                    @foreach (var modelState in ViewData.ModelState.Values)
                    {
                        foreach (var error in modelState.Errors)
                        {
                            if (!string.IsNullOrEmpty(error.ErrorMessage))
                            {
                                <li>@error.ErrorMessage</li>
                            }
                        }
                    }
                </ul>
            </div>
        }

        <form asp-action="ForgotPassword" asp-controller="Auth" method="post">
            @Html.AntiForgeryToken()

            <div class="mb-3 text-start">
                <label for="Email" class="form-label fw-semibold small">Email đăng ký</label>
                <input type="email" id="Email" name="Email" class="form-control" placeholder="name@example.com" required />
            </div>

            <div class="mt-3">
                <button type="submit" class="btn btn-primary w-100 py-2 fw-bold text-white rounded-pill">
                    Gửi yêu cầu khôi phục
                </button>
            </div>
        </form>

        <div class="mt-3">
            <a href="/Auth/Login" class="text-decoration-none text-muted small">← Quay lại Đăng nhập</a>
        </div>
    </div>
</div>