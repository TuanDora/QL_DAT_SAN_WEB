@model List<MyCourtBooking.Modules.Courts.CourtViewModel>

@{
    // 1. Áp dụng Layout chung để nạp Bootstrap CSS & Header/Footer
    Layout = "_Layout";
    ViewData["Title"] = "Danh Sách Sân Thể Thao";

    var districts = ViewBag.Districts as List<string> ?? new List<string>();
    var courtTypes = ViewBag.CourtTypes as List<MyCourtBooking.Modules.Courts.CourtTypeViewModel> ?? new List<MyCourtBooking.Modules.Courts.CourtTypeViewModel>();
    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
    int totalCount = ViewBag.TotalCount ?? (Model != null ? Model.Count : 0);
}

<div class="container py-4">
    <!-- TIÊU ĐỀ TRANG -->
    <div class="row mb-4 align-items-center">
        <div class="col-md-6">
            <h2 class="fw-bold text-primary mb-1"><i class="bi bi-dribbble me-2"></i>Danh Sách Sân Thể Thao</h2>
            <p class="text-muted mb-0">Tìm kiếm và chọn sân phù hợp để đặt lịch luyện tập</p>
        </div>
        <div class="col-md-6 text-md-end">
            <span class="badge bg-light text-dark border p-2 fs-6">
                Tổng số sân: <strong class="text-primary" id="totalCourtCount">@totalCount</strong>
            </span>
        </div>
    </div>

    <!-- BỘ LỌC TÌM KIẾM NÂNG CAO -->
    <div class="card shadow-sm border-0 mb-4 bg-white rounded-4 p-3">
        <form action="/Courts" method="get">
            <div class="row g-3">
                <!-- 1. Từ khóa -->
                <div class="col-md-3">
                    <label class="form-label small text-muted fw-semibold mb-1">Từ khóa tìm kiếm:</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0"><i class="bi bi-search text-muted"></i></span>
                        <input type="text" name="keyword" value="@ViewBag.Keyword" class="form-control bg-light border-start-0" placeholder="Tên sân, địa chỉ...">
                    </div>
                </div>

                <!-- 2. Khu vực (Quận/Huyện) -->
                <div class="col-md-3">
                    <label class="form-label small text-muted fw-semibold mb-1">Khu vực / Quận Huyện:</label>
                    <select name="district" class="form-select bg-light">
                        <option value="Tất cả">-- Tất cả khu vực --</option>
                        @foreach (var district in districts)
                        {
                            <option value="@district" selected="@(ViewBag.SelectedDistrict == district ? "selected" : null)">@district</option>
                        }
                    </select>
                </div>

                <!-- 3. Loại sân -->
                <div class="col-md-2">
                    <label class="form-label small text-muted fw-semibold mb-1">Loại sân:</label>
                    <select name="courtTypeId" class="form-select bg-light">
                        <option value="0">-- Tất cả loại sân --</option>
                        @foreach (var type in courtTypes)
                        {
                            <option value="@type.Id" selected="@(ViewBag.SelectedCourtTypeId == type.Id ? "selected" : null)">@type.Name</option>
                        }
                    </select>
                </div>

                <!-- 4. Đánh giá tối thiểu -->
                <div class="col-md-2">
                    <label class="form-label small text-muted fw-semibold mb-1">Đánh giá tối thiểu:</label>
                    <select name="minRating" class="form-select bg-light">
                        <option value="0">Tất cả đánh giá</option>
                        <option value="4.5" selected="@(ViewBag.MinRating == 4.5 ? "selected" : null)">★ 4.5 trở lên</option>
                        <option value="4.0" selected="@(ViewBag.MinRating == 4.0 ? "selected" : null)">★ 4.0 trở lên</option>
                        <option value="3.5" selected="@(ViewBag.MinRating == 3.5 ? "selected" : null)">★ 3.5 trở lên</option>
                    </select>
                </div>

                <!-- 5. Nút bấm Lọc / Đặt lại -->
                <div class="col-md-2 d-flex align-items-end gap-2">
                    <button type="submit" class="btn btn-primary fw-bold w-100 rounded-3 py-2" style="background-color: var(--blue-accent, #1f5fe0);">
                        <i class="bi bi-funnel-fill me-1"></i> Lọc kết quả
                    </button>
                    <a href="/Courts" class="btn btn-outline-secondary rounded-3 py-2 px-3" title="Xóa bộ lọc"><i class="bi bi-arrow-counterclockwise"></i></a>
                </div>
            </div>
        </form>
    </div>

    <!-- DANH SÁCH SÂN (GRID CARD) -->
    @if (Model != null && Model.Any())
    {
        <div class="row g-4" id="courtGrid">
            @foreach (var court in Model)
            {
                // Xử lý đường dẫn ảnh an toàn
                var imgUrl = string.IsNullOrWhiteSpace(court.ImageUrl)
        ? "https://images.unsplash.com/photo-1626224583764-f87db24ac4ea?w=800"
        : court.ImageUrl;

                <div class="col-12 col-md-6 col-lg-4">
                    <div class="card court-card h-100 shadow-sm border-0 rounded-4 overflow-hidden bg-white">
                        <div class="position-relative">
                            <!-- Đường dẫn ảnh đã được chuẩn hóa -->
                            <img src="@imgUrl"
                                 class="card-img-top"
                                 alt="@court.Name"
                                 style="height: 210px; object-fit: cover; width: 100%; display: block;" />
                            <!-- Badge Trạng Thái -->
                            <div class="position-absolute top-0 end-0 m-3">
                                @if (court.Status == "Available")
                                {
                                    <span class="badge bg-success border px-3 py-2 rounded-pill">Sân trống</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark border px-3 py-2 rounded-pill">Bảo trì</span>
                                }
                            </div>

                            <!-- Badge Loại Sân -->
                            <div class="position-absolute bottom-0 start-0 m-3">
                                <span class="badge bg-dark text-white px-2.5 py-1.5 rounded">@court.TypeName</span>
                            </div>
                        </div>

                        <div class="card-body d-flex flex-column p-4">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <h5 class="card-title fw-bold mb-0 text-dark">@court.Name</h5>
                                <span class="badge bg-light text-warning border fw-bold px-2 py-1">
                                    ★ @court.Rating.ToString("0.0")
                                </span>
                            </div>

                            <p class="text-muted small mb-2"><i class="bi bi-geo-alt text-danger me-1"></i>@court.District</p>
                            
                            <p class="card-text text-secondary small flex-grow-1 mb-3 text-truncate-2" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; line-height: 1.5;">
                                @court.Description
                            </p>

                            <div class="d-flex align-items-center justify-content-between pt-3 border-top">
                                <span class="price-tag fs-5 fw-bold text-danger">@court.BasePrice.ToString("#,##0") đ/h</span>
                                <a href="/Courts/Detail/@court.Id" class="btn btn-outline-primary btn-sm rounded-pill px-3 fw-semibold">
                                    Chi tiết <i class="bi bi-arrow-right ms-1"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- PHẦN PHÂN TRANG (PAGINATION) -->
        @if (totalPages > 1)
        {
            <nav class="mt-5">
                <ul class="pagination justify-content-center">
                    <li class="page-item @(currentPage <= 1 ? "disabled" : "")">
                        <a class="page-link" href="/Courts?page=@(currentPage - 1)&keyword=@ViewBag.Keyword&district=@ViewBag.SelectedDistrict&courtTypeId=@ViewBag.SelectedCourtTypeId&minRating=@ViewBag.MinRating">&laquo; Trước</a>
                    </li>
                    @for (int i = 1; i <= totalPages; i++)
                    {
                        <li class="page-item @(i == currentPage ? "active" : "")">
                            <a class="page-link" href="/Courts?page=@i&keyword=@ViewBag.Keyword&district=@ViewBag.SelectedDistrict&courtTypeId=@ViewBag.SelectedCourtTypeId&minRating=@ViewBag.MinRating">@i</a>
                        </li>
                    }
                    <li class="page-item @(currentPage >= totalPages ? "disabled" : "")">
                        <a class="page-link" href="/Courts?page=@(currentPage + 1)&keyword=@ViewBag.Keyword&district=@ViewBag.SelectedDistrict&courtTypeId=@ViewBag.SelectedCourtTypeId&minRating=@ViewBag.MinRating">Sau &raquo;</a>
                    </li>
                </ul>
            </nav>
        }
    }
    else
    {
        <!-- TRẠNG THÁI KHÔNG TÌM THẤY KẾT QUẢ -->
        <div class="text-center py-5 bg-white rounded-4 shadow-sm my-4">
            <i class="bi bi-emoji-frown fs-1 text-muted mb-3 d-block"></i>
            <h5 class="fw-bold text-dark">Không tìm thấy sân phù hợp</h5>
            <p class="text-muted small">Rất tiếc, không có sân nào phù hợp với bộ lọc tìm kiếm của bạn. Vui lòng thử tìm kiếm lại với điều kiện khác.</p>
            <a href="/Courts" class="btn btn-primary btn-sm rounded-pill px-4 fw-semibold mt-2">Xem tất cả các sân</a>
        </div>
    }
</div>